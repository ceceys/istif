<Window x:Class="Istif.AnaPencere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="Manual" ShowInTaskbar="False" ShowActivated="False"
        Background="{StaticResource Zemin}" Icon="/Assets/uygulama.ico"
        UseLayoutRounding="True">

    <!-- Çerçevesiz pencere: kenar tutma, Aero Snap ve başlık çubuğundan sürükleme WindowChrome'dan gelir -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Renkler temaya göre AnaPencere.xaml.cs'de (Tema.cs) verilir -->
    <Border x:Name="Kok" BorderBrush="#2A3A63" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BaslikSatiri" Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık çubuğu -->
            <Border x:Name="BaslikCubugu" Background="{StaticResource Lacivert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                        <Image Source="/Assets/simge-256.png" Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="UrunAdi" Margin="10,0,0,1" VerticalAlignment="Center"
                                   FontFamily="{StaticResource BaslikYazi}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F2F4F7" />
                        <TextBlock x:Name="BelgeAdi" Margin="12,0,0,1" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MetinYazi}" FontSize="12.5" Foreground="#8A929E"
                                   TextTrimming="CharacterEllipsis" MaxWidth="560" />
                    </StackPanel>

                    <StackPanel x:Name="BaslikDugmeleri" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="KucultDugme" Style="{StaticResource BaslikDugmesi}" Click="Kucult_Click">
                            <Path Style="{StaticResource DugmeSimgesi}" Data="M0,0.5 H10" />
                        </Button>
                        <Button x:Name="BuyutDugme" Style="{StaticResource BaslikDugmesi}" Click="Buyut_Click">
                            <Path x:Name="BuyutSimge" Style="{StaticResource DugmeSimgesi}" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                        </Button>
                        <Button x:Name="KapatDugme" Style="{StaticResource KapatDugmesi}" Click="Kapat_Click">
                            <Path Style="{StaticResource DugmeSimgesi}" Data="M0,0 L10,10 M10,0 L0,10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="Web" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
